{
  "name": "student-portal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev": "node scripts/dev.mjs",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:preview": "npm --prefix frontend run preview",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:test": "npm --prefix backend run test",
    "client:build": "npm run frontend:build",
    "client:dev": "npm run frontend:dev",
    "client:lint": "npm run frontend:lint",
    "server:dev": "npm run backend:dev",
    "server:start": "npm run backend:start",
    "server:test": "npm run backend:test",
    "db:migrate": "npm --prefix backend run migrate",
    "db:migrate:status": "npm --prefix backend run migrate:status",
    "db:verify": "npm --prefix backend run db:verify",
    "seed:users": "npm --prefix backend run seed:users",
    "e2e": "node e2e/browser-smoke.test.mjs",
    "check": "npm run backend:test && npm run frontend:lint && npm run frontend:build && npm run e2e"
  }
}
